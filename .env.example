# Server-side only. Never prefix with VITE_ — it must not reach the browser bundle.
OPENAI_API_KEY=
# Model for scenario generation, instructor and debrief (default gpt-5.5)
OPENAI_MODEL=
# Low-latency model for patient dialogue (default gpt-5.4-mini)
OPENAI_FAST_MODEL=
# API server port (Vite proxies /api to it in development)
PORT=8787
# Only when the front end is hosted on another origin (e.g. GitHub Pages): allow it to call this API
ALLOWED_ORIGIN=
